# Optional. When set, metadata is fetched from the YouTube Data API v3
# (richer data, incl. duration). When unset, the official oEmbed endpoint
# is used instead (no key needed, no duration field).
YOUTUBE_API_KEY=

# Optional. Comma-separated list of origins allowed to call the API
# cross-origin, e.g. https://example.com,https://www.example.com
# Leave unset for same-origin only. Never use "*" with credentials.
ALLOWED_ORIGINS=

# Per-IP inspect rate limit (requests per minute).
RATE_LIMIT_PER_MINUTE=30
